# local / mock / wechat
WANREN_PUBLISHER=mock
WANREN_AUTH_MODE=dev
WANREN_ADMIN_EMAIL=admin@wanren.local
# dev default password is wanren-dev-admin; production requires a real secret here
WANREN_ADMIN_PASSWORD=
# App secret for encrypting API keys stored in the database (openssl rand -hex 32).
# REQUIRED in production; set it once — changing it invalidates already-saved keys.
WANREN_APP_SECRET_KEY=
WANREN_REGISTRATION_ENABLED=true
WANREN_REGISTRATION_ROLE=EDITOR
WANREN_WORKFLOW_MODE=background
WANREN_EMBEDDED_WORKER=true
WANREN_WORKER_POLL_SECONDS=1
WANREN_DB_PATH=data/wanren.sqlite3
WANREN_STORAGE_PATH=storage
WANREN_MAX_UPLOAD_MB=20
WANREN_VIDLENS=/path/to/vidlens/scripts/vidlens.py
WANREN_TEXT_PROVIDER=local
# Required when WANREN_TEXT_PROVIDER=openai_compatible
WANREN_TEXT_MODEL=
WANREN_TEXT_API_BASE=https://api.openai.com/v1
WANREN_TEXT_API_KEY=
WANREN_TEXT_TIMEOUT_SECONDS=120
WANREN_TEXT_MAX_RETRIES=2
WANREN_TEXT_FALLBACK_LOCAL=false
WANREN_TEXT_INPUT_PRICE_PER_M=0
WANREN_TEXT_OUTPUT_PRICE_PER_M=0
# Optional JSON: {"openai_compatible/gpt-4o":{"input_per_million":2.5,"output_per_million":10}}
WANREN_TEXT_MODEL_PRICES=
WANREN_TEXT_MONTHLY_BUDGET_USD=0
WANREN_SEARCH_PROVIDER=duckduckgo
WANREN_SEARCH_TIMEOUT_SECONDS=15
WANREN_SEARCH_MAX_RESULTS=5

# Only required when WANREN_PUBLISHER=wechat
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Plain-text callback token used by WeChat server URL verification and event signatures
WANREN_WECHAT_CALLBACK_TOKEN=

# Multi-account pattern: each account stores only its AppID in WanRen.
# Put each secret in its own environment variable and reference it from account
# settings as credential_env / callback_token_env. Never commit the real .env file.
# WECHAT_APP_SECRET_wx1234567890=
# WECHAT_CALLBACK_TOKEN_wx1234567890=
#
# Configure this callback URL in each Official Account admin console:
# https://your-public-domain/wechat/{wanren_account_id}/callback
